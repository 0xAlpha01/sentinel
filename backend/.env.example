NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sentinel
CLIENT_ORIGIN=http://localhost:5173
TRUST_PROXY=0

# Generate each secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-48-bytes
JWT_MFA_SECRET=change-me-to-a-different-long-random-string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Used only by `npm run seed:admin`
ADMIN_EMAIL=admin@sentinel.dev
ADMIN_PASSWORD=ChangeThisPassword123!
